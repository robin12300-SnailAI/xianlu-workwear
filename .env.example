# ========== 复制本文件为 .env.local 后填写 ==========

# Stripe 收款密钥（test 模式，在 https://dashboard.stripe.com/test/apikeys 获取）
# 没有 Stripe 也能先跑站点，只是结账会提示"未配置"
STRIPE_SECRET_KEY=sk_test_替换成你的
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_替换成你的

# 本站地址（结账成功跳转用）。本地开发保持这个即可
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 后台 /admin 访问口令（部署前务必改成复杂字符串）
ADMIN_PASSWORD=change-me

# 订单通知邮箱（可先填你自己的邮箱）
ORDER_NOTIFY_EMAIL=you@example.com
